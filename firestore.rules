rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /rentals/{document=**} {
      allow read, write: if signedIn();
    }

    match /bills/{document=**} {
      allow read, write: if signedIn();
    }

    match /rentalRecords/{document=**} {
      allow read, write: if signedIn();
    }

    match /billRecords/{document=**} {
      allow read, write: if signedIn();
    }

    match /shoes/{document=**} {
      allow read, write: if signedIn();
    }

    match /shoeSales/{document=**} {
      allow read, write: if signedIn();
    }

    match /shoePayments/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
